# このファイルは4つの実ファイルの内容をまとめたテンプレートです。
# 実際には、下記セクションごとに指定されたパスへ分割して配置してください。
# DATABASE_URL の値は Neon コンソールの Branches → development から取得します。
# 4ファイルすべてが同じエンドポイントID（ep-...）を指すことを確認してください
# （main のIDと取り違えると本番ブランチへの誤書き込みにつながります）。

# ================================
# apps/web/.env.local
# 読む主体: Next.js
# ================================
# プールド接続（ホスト名に -pooler が付くもの）を使用する
DATABASE_URL=
NEXT_PUBLIC_GA_ID=


# ================================
# apps/admin/.env.local
# 読む主体: Next.js
# ================================
# プールド接続（ホスト名に -pooler が付くもの）を使用する
DATABASE_URL=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_ALLOWED_GITHUB_LOGIN=
GEMINI_API_KEY=


# ================================
# apps/scripts/.env
# 読む主体: tsx --env-file-if-exists=.env
# ================================
# 直結接続（-pooler 無し）を使用する。長めのトランザクションを張るため
DATABASE_URL=
ODPT_API_KEY=


# ================================
# packages/database/.env
# 読む主体: dotenv/config（drizzle.config.ts）
# ================================
# 直結接続（-pooler 無し）を使用する。プールド接続は PgBouncer の
# transaction モードでセッション状態が保持されず、drizzle-kit の
# search_path 指定が効かなくなるため
DATABASE_URL=
